<?xml version="1.0" encoding="utf-8"?>
<!--
  chiaki-ng's protocol library (lib/) built as a static library for UWP / Xbox.

  - Compiled with clang-cl (ClangCL toolset): chiaki's C code is written for GCC/Clang and is not
    tested with MSVC's C compiler. clang-cl uses the MSVC ABI, so it links fine into the app.
  - LAN only: the internet remote play sources are replaced by stubs/remote_stubs.c.
  - takion.pb.c/h are pre-generated by nanopb into generated/ (see README to regenerate).
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6B1E3C2A-5D47-4F1B-9E2A-0C7D3F1A8B01}</ProjectGuid>
    <RootNamespace>ChiakiLib</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>ClangCL</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(PsXboxRoot)build\$(Platform)\$(Configuration)\ChiakiLib\</OutDir>
    <IntDir>$(PsXboxRoot)build\obj\$(Platform)\$(Configuration)\ChiakiLib\</IntDir>
    <TargetName>chiaki</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(MSBuildThisFileDirectory)shim;
        $(MSBuildThisFileDirectory)generated;
        $(ChiakiDir)lib\include;
        $(ChiakiDir)lib\src;
        $(ChiakiDir)third-party\nanopb;
        $(ChiakiDir)third-party\jerasure\include;
        $(ChiakiDir)third-party\gf-complete\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WINAPI_FAMILY=WINAPI_FAMILY_APP;
        _WIN32_WINNT=0x0A00;
        WIN32_LEAN_AND_MEAN;
        _CRT_SECURE_NO_WARNINGS;
        _CRT_NONSTDC_NO_WARNINGS;
        _WINSOCK_DEPRECATED_NO_WARNINGS;
        PB_C99_STATIC_ASSERT;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <AdditionalOptions>-Wno-everything %(AdditionalOptions)</AdditionalOptions>
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- chiaki core -->
    <ClCompile Include="$(ChiakiDir)lib\src\*.c"
               Exclude="$(ChiakiDir)lib\src\aia.c;$(ChiakiDir)lib\src\aia_openssl.c;$(ChiakiDir)lib\src\ffmpegdecoder.c;$(ChiakiDir)lib\src\pidecoder.c" />
    <ClCompile Include="$(ChiakiDir)lib\src\remote\rudp.c" />
    <ClCompile Include="$(ChiakiDir)lib\src\remote\rudpsendbuffer.c" />
    <ClCompile Include="stubs\remote_stubs.c" />
    <ClCompile Include="generated\takion.pb.c" />

    <!-- nanopb -->
    <ClCompile Include="$(ChiakiDir)third-party\nanopb\pb_common.c" />
    <ClCompile Include="$(ChiakiDir)third-party\nanopb\pb_encode.c" />
    <ClCompile Include="$(ChiakiDir)third-party\nanopb\pb_decode.c" />

    <!-- gf-complete + jerasure (FEC) -->
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_wgen.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_w4.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_w8.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_w16.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_w32.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_w64.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_w128.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_rand.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_general.c" />
    <ClCompile Include="$(ChiakiDir)third-party\gf-complete\src\gf_cpu.c">
      <ForcedIncludeFiles>intrin.h</ForcedIncludeFiles>
    </ClCompile>
    <ClCompile Include="$(ChiakiDir)third-party\jerasure\src\galois.c" />
    <ClCompile Include="$(ChiakiDir)third-party\jerasure\src\jerasure.c" />
    <ClCompile Include="$(ChiakiDir)third-party\jerasure\src\reed_sol.c" />
    <ClCompile Include="$(ChiakiDir)third-party\jerasure\src\cauchy.c" />
    <ClCompile Include="$(ChiakiDir)third-party\jerasure\src\liberation.c" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
