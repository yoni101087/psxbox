<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PsXboxRoot>$(MSBuildThisFileDirectory)</PsXboxRoot>
    <ChiakiDir>$(MSBuildThisFileDirectory)third_party\chiaki-ng\</ChiakiDir>

    <!-- vcpkg (manifest mode, see vcpkg.json). Both projects share one install tree. -->
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <VcpkgInstalledDir>$(MSBuildThisFileDirectory)vcpkg_installed\</VcpkgInstalledDir>
    <!-- The triplet is already static; VcpkgUseStatic would append "-static" to its name. -->
    <VcpkgTriplet>x64-uwp-psxbox</VcpkgTriplet>
    <VcpkgHostTriplet>x64-windows</VcpkgHostTriplet>
  </PropertyGroup>
</Project>
