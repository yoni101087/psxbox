<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Publisher must match the subject of the signing certificate (see scripts/make-cert.ps1). -->
  <Identity Name="PsXbox.RemotePlay" Publisher="CN=PsXboxDev" Version="0.3.0.0" />

  <mp:PhoneIdentity PhoneProductId="4f7c2a8e-3b61-4d0e-9a52-7c1e5b9d2f10" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>PS Xbox</DisplayName>
    <PublisherDisplayName>PsXbox contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="PsXbox.App">
      <uap:VisualElements
        DisplayName="PS Xbox"
        Description="PlayStation Remote Play client for Xbox (based on chiaki-ng)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0E1015"/>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <!-- Required for LAN discovery, registration and streaming. -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
